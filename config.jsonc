{
    "$schema": "https://github.com",
    "logo": {
	"source": "arch_small",
        "position": "left",
        "padding": {
            "top": 2,
            "right": 6,
            "left": 4
        }
    },
    "display": {
        "separator": "    ",
        "key": {
            "width": 12
        }
    },
    "modules": [
        {
            "type": "custom",
            "format": ""
        },
        "title",
        "os",
        "kernel",
        {
            "type": "command",
            "key": "cpu temp",
            "text": "echo \"$(($(cat /sys/class/hwmon/hwmon5/temp1_input) / 1000))  C\""
        },
        "colors"
    ]
}
